{
  "name": "yamnaya",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @yamnaya/web dev",
    "build": "pnpm --filter @yamnaya/web build",
    "start": "pnpm --filter @yamnaya/web start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx services/worker/index.ts",
    "scenario": "tsx scripts/scenario.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.45.1",
    "fast-xml-parser": "^5.3.6",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.4"
  }
}
