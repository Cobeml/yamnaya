{
  "name": "yamnaya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @yamnaya/web dev",
    "build": "pnpm --filter @yamnaya/web build",
    "start": "pnpm --filter @yamnaya/web start",
    "setup": "tsx scripts/camps/setup.ts",
    "db:migrate": "tsx scripts/camps/migrate.ts",
    "worker": "tsx services/worker/camps.ts",
    "up": "docker compose --env-file .env.camps up -d --build",
    "down": "docker compose --env-file .env.camps down",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.camps.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "camps:setup": "tsx scripts/camps/setup.ts",
    "camps:migrate": "tsx scripts/camps/migrate.ts",
    "camps:dev": "pnpm --filter @yamnaya/web exec next dev --hostname 0.0.0.0 --port 3110",
    "camps:worker": "tsx services/worker/camps.ts",
    "camps:up": "docker compose --env-file .env.camps up -d --build",
    "camps:down": "docker compose --env-file .env.camps down",
    "camps:test:e2e": "playwright test --config playwright.camps.config.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.4"
  }
}
