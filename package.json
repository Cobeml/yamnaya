{
  "name": "yamnaya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @yamnaya/web dev",
    "build": "pnpm --filter @yamnaya/web build",
    "start": "pnpm --filter @yamnaya/web start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "deploy:env": "tsx scripts/vercel-env.ts",
    "demo:record": "tsx scripts/demo/record.ts",
    "demo:edit": "tsx scripts/demo/edit.ts",
    "demo:run": "tsx scripts/demo/run.ts",
    "demo:terminal": "tsx scripts/demo/terminal.ts",
    "demo:check-terminal": "tsx scripts/demo/check-terminal.ts",
    "worker": "tsx services/worker/index.ts",
    "scenario": "tsx scripts/scenario.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "preflight": "tsx scripts/preflight.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "camps:setup": "tsx scripts/camps/setup.ts",
    "camps:migrate": "tsx scripts/camps/migrate.ts",
    "camps:dev": "pnpm --filter @yamnaya/web exec next dev --hostname 0.0.0.0 --port 3110",
    "camps:worker": "tsx services/worker/camps.ts",
    "camps:up": "docker compose --env-file .env.camps up -d --build",
    "camps:down": "docker compose --env-file .env.camps down",
    "camps:test:e2e": "playwright test --config playwright.camps.config.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.45.1",
    "fast-xml-parser": "^5.3.6",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.4"
  }
}
