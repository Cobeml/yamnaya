# =========================
# AI & Agent State/Outputs (Computer Use specific)
# =========================
# Local Vector DBs
chroma_db/
.chroma/
faiss_index/
# Agent memory and state tracking
agent_memory/
traces/
# Screen captures & interactions from GUI use
screenshots/
recordings/
*.png
*.mp4
*.mkv
*.avi
# Application logs
logs/
*.log

# =========================
# Cybersecurity, Recon & Scan Outputs
# =========================
*.pcap
*.pcapng
*.cap
*.nmap
*.gnmap
scan_results/
reports/
wordlists/
dict/
# Ignore compiled exploit binaries (keep source code only)
exploits/**/*.bin
exploits/**/*.elf
exploits/**/*.exe

# =========================
# Openclaw Specific Workspace
# =========================
# Ignore temporary outputs generated by the agent inside the workspace volume
# (You still want to track your wrapper/agent source code if you put it in workspace)
workspace/tmp/
workspace/logs/
workspace/output/
workspace/.cache/
workspace/temp_downloads/
