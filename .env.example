# Run pnpm run setup to generate local-only passwords and tokens. Do not commit .env.
DATABASE_URL=postgres://yamnaya:yamnaya@localhost:5544/yamnaya
# Optional direct database URI for migrations; pooled DATABASE_URL serves requests.
DIRECT_DATABASE_URL=
YAMNAYA_URL=http://localhost:3100
# For hosted deployment, set both to your Vercel HTTPS origin.
# Leave PUBLIC_URL empty locally so host and in-container browsers both work.
YAMNAYA_DOCKER_URL=http://web:3100
YAMNAYA_PUBLIC_URL=
YAMNAYA_STORAGE=postgres
SESSION_SECRET=
DEMO_SECURITY_PASSWORD=
DEMO_PLATFORM_PASSWORD=
DEMO_OPERATIONS_PASSWORD=
DEFENDER_TOKEN=
ATTACKER_TOKEN=
WORKER_TOKEN=
OPENAI_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SECURITY_USER_ID=
SLACK_PLATFORM_USER_ID=
SLACK_OPERATIONS_USER_ID=
GITHUB_TOKEN=
GITHUB_REPOSITORY=Cobeml/yamnaya
# Vercel uses DATABASE_URL and the same session/role secrets. No agent loops run there.
CODE_LAB_URL=http://code-lab:4100
DEFENDER_TURN_LIMIT=40
ATTACKER_TURN_LIMIT=12
