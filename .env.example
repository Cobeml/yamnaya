# Run pnpm run setup to generate private .env.camps secrets.
CAMP_STORAGE=file
CAMP_DATA_DIR=runtime/camps
CAMP_DATABASE_URL=postgres://camps:camps@127.0.0.1:5545/camps
CAMP_OPERATOR_ID=operator
CAMP_OPERATOR_PASSWORD=
CAMP_SESSION_SECRET=
CAMP_WORKER_TOKEN=
CAMP_RUNTIME_SECRET=
CAMP_PREVIEW_SECRET=
CAMP_PUBLIC_URL=http://localhost:3110
CAMP_API_URL=http://127.0.0.1:3110
CAMP_PREVIEW_URL=http://127.0.0.1:4112
CAMP_MODEL_PROXY_URL=http://127.0.0.1:4112/v1
CAMP_HERMES_URL=http://127.0.0.1:8765
CAMP_BROWSER_URL=http://127.0.0.1:4113
CAMP_SANDBOX_URL=http://127.0.0.1:4111
CAMP_MODEL_BASE_URL=https://api.openai.com/v1
CAMP_MODEL=gpt-6-astra
CAMP_MODEL_API_MODE=chat_completions
CAMP_MODEL_API_KEY=
CAMP_GITHUB_TOKEN=
CAMP_DISCORD_BOT_TOKEN=
CAMP_DISCORD_OPERATOR_IDS=
CAMP_SEARCH_URL=
# Cultural camps: Gemini credentials remain in the local executor.
CAMP_GEMINI_API_KEY=
CAMP_GEMINI_FREE_TIER=false
CAMP_GEMINI_MONTHLY_USD=10
CAMP_GEMINI_RPM=1000
CAMP_GEMINI_TPM=2000000
CAMP_GEMINI_RPD=10000
# Gmail send-only OAuth; no mailbox-reading scope is needed.
CAMP_GMAIL_CLIENT_ID=
CAMP_GMAIL_CLIENT_SECRET=
CAMP_GMAIL_REFRESH_TOKEN=
CAMP_GMAIL_SENDER=
# Hosted UI relays to the authenticated local API.
CAMP_ORIGIN_URL=
CAMP_ORIGIN_SECRET=
CAMP_NEON_MIGRATION=
CAMP_OBJECT_DIR=runtime/objects
CAMP_SEARCH_SECRET=
CAMP_AMERICA_REPOSITORY=Cobeml/yamnaya-america
CAMP_CHINA_REPOSITORY=Cobeml/yamnaya-china
