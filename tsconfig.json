{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "preserve",
    "strict": true, "noEmit": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "types": ["node"],
    "baseUrl": ".", "paths": {"@yamnaya/core": ["packages/core/src/index.ts"]}
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "services/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "**/.next", "runtime"]
}
